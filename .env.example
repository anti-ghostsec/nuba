# Which catalog (data source) to use. Catalogs live in src/lib/server/catalog/.
NUBA_CATALOG=anilist

# AniList GraphQL endpoint. Point it at your own caching proxy if you run one.
ANILIST_ENDPOINT=https://graphql.anilist.co

# Serve catalog images through this server (recommended for .onion hosting,
# so visitors' browsers never contact third-party image hosts directly).
NUBA_IMAGE_PROXY=true

# Where Nuba keeps its database (accounts and lists).
NUBA_DATA_DIR=./data

# The address people use to reach the site. Required in production: forms
# (sign-in, lists) are checked against it to block cross-site posts.
# For an onion service this is plain http — Tor already encrypts end to end.
# ORIGIN=http://youraddress.onion

# Where the built server listens. Keep it on localhost behind Tor.
HOST=127.0.0.1
PORT=3000

# Who can create accounts: "open", or "closed" while you keep the site private.
NUBA_REGISTRATION=open

# Most new accounts per hour, site-wide (over Tor everyone shares one IP, so
# this can't be per visitor). Slows down bulk sign-up spam.
NUBA_SIGNUPS_PER_HOUR=30

# If you also run a clearnet mirror, its pages advertise the onion with this
# (Tor Browser then offers to switch). Leave empty otherwise.
# NUBA_ONION_URL=http://youraddress.onion
