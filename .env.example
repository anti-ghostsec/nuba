# Which catalog (data source) to use. Catalogs live in src/lib/server/catalog/.
NUBA_CATALOG=anilist

# AniList GraphQL endpoint. Point it at your own caching proxy if you run one.
ANILIST_ENDPOINT=https://graphql.anilist.co

# Serve catalog images through this server (recommended for .onion hosting,
# so visitors' browsers never contact third-party image hosts directly).
NUBA_IMAGE_PROXY=true

# Where Nuba keeps its database (accounts and lists).
NUBA_DATA_DIR=./data
